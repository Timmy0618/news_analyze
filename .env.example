# ── Required ──────────────────────────────────────────────
# PostgreSQL (Supabase format)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres  # session pooler，IPv4 可用

# Jina AI (embeddings)
JINA_API_KEY=your_jina_api_key

# Embedding model (default: jina-embeddings-v5-text-small, 1024 dimensions)
JINA_MODEL=jina-embeddings-v5-text-small

# OpenAI-compatible LLM (used by utils/llm.py)
OPENAPI_KEY=EMPTY  # 本地 OpenAI 相容伺服器填任意非空字串
LLM_URL=http://localhost:8000/v1
LLM_MODEL=qwen3.6-35b

# ── Optional: services ────────────────────────────────────
# Firecrawl self-hosted URL
# firecrawl 綁在 docker bridge gateway，host 與容器都走這個 IP
FIRECRAWL_URL=http://172.17.0.1:3002

# ── Optional: scheduler ───────────────────────────────────
SCHEDULER_ENABLED=true

# Cron mode: scrape at fixed times (recommended)
SCRAPE_SCHEDULE=06:00,12:00,18:00,22:00

# Interval mode fallback (ignored when SCRAPE_SCHEDULE is set)
SCRAPE_INTERVAL_MINUTES=0

# ── Optional: scraper config ──────────────────────────────
SCRAPE_PAGES=5
SCRAPE_MAX_ARTICLES=50
SCRAPE_TARGET_DATE=    # 留空表示今天，格式: YYYY-MM-DD
SCRAPE_NO_DB=false

# ── Optional: embedding config ────────────────────────────
EMBED_INTERVAL_MINUTES=60
EMBED_BATCH_SIZE=10
EMBED_LIMIT=
EMBED_FORCE=false

# ── Optional: Obsidian export ──────────────────────────────
OBSIDIAN_VAULT_PATH=    # Vault 路徑，留空則停用自動匯出
OBSIDIAN_EXPORT_HOUR=3  # 每日幾點匯出（預設凌晨 3 點）
